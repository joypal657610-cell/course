# Server configuration
PORT=3000
NODE_ENV=development

# Hidden Administrator PIN (Initial default: 20055)
ADMIN_PIN=20055
ADMIN_SESSION_SECRET=techvantage_super_secure_jwt_or_hmac_secret_2026_xyz

# Telegram Bot API Configuration
# Get BOT Token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
# Telegram Channel or Supergroup Chat ID (e.g. -1001234567890)
TELEGRAM_CHAT_ID=-1001234567890
# Telegram Invite Link Expiration in hours (default: 48)
TELEGRAM_INVITE_EXPIRY_HOURS=48

# Payment Numbers (Editable in Admin Panel too)
BKASH_NUMBER=01983463798
NAGAD_NUMBER=01771576066

# Supabase PostgreSQL Database (Optional for remote database persistence)
# Leave empty to use local auto-persisted relational database engine
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# SMS / OTP Provider for Phone Recovery (Optional - MIM SMS, Twilio, or GreenWeb)
# If unconfigured, the recovery dialog displays clear setup instructions.
OTP_PROVIDER=none
OTP_API_KEY=
OTP_SENDER_ID=TechVantage
